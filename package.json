{
  "name": "self-tools",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "lint": "pnpm run format:check && pnpm run boundaries && pnpm run oxlint && pnpm run knip && pnpm run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "oxlint": "oxlint",
    "knip": "knip --config knip.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config web/packages/portal/vite.config.ts",
    "build": "pnpm --filter './web/packages/*' run build",
    "commit": "git-cz",
    "prepare": "husky",
    "boundaries": "node web/config/check-boundaries.mts",
    "graphql:check": "node web/config/generate-graphql.mts --check",
    "build:check": "pnpm build && node web/config/check-bundle.mts"
  },
  "devDependencies": {
    "@apollo/client": "^4.2.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "custom-graphql": "workspace:*",
    "git-cz": "^4.9.0",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "oxc-parser": "0.137.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "timezone-mock": "^1.4.3",
    "ts-node": "^10.9.2",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.0.0"
}
