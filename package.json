{
  "name": "self-tools",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "lint": "pnpm run format:check && pnpm run boundaries && pnpm run oxlint && pnpm run knip && pnpm run typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "oxlint": "oxlint",
    "knip": "knip --config knip.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config web/packages/portal/vite.config.ts",
    "build": "pnpm --filter './web/packages/*' run build",
    "commit": "git-cz",
    "prepare": "husky",
    "boundaries": "node web/config/check-boundaries.mts",
    "graphql:check": "node web/config/generate-graphql.mts --check",
    "build:check": "pnpm build && node web/config/check-bundle.mts"
  },
  "devDependencies": {
    "@apollo/client": "^4.2.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "custom-graphql": "workspace:*",
    "git-cz": "^4.9.0",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.35.1",
    "oxc-parser": "0.149.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "timezone-mock": "^1.4.3",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.4.0"
}
