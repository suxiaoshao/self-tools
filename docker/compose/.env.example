# Copy to .env and supply your own credentials. Never add .env to Git/build input.
# This file supplies values only; Compose explicitly selects keys per service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# Existing dedicated database roles/databases must be created before migration.
AUTH_PG=
BOOKMARKS_PG=
COLLECTIONS_PG=
USERNAME=
PASSWORD=
SECRET=
AUTH_ORIGIN=https://sushao.top
# AUTH_RP_ID defaults to the origin host.
# CORS_ALLOWED_ORIGINS defaults to https://sushao.top; an empty value denies all.
# GATEWAY_* optional settings are listed in server/packages/gateway/src/config.rs.
